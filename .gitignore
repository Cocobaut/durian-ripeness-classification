# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch Checkpoint weights (*.pth, *.pt)
*.pth
*.pt
!checkpoints/**/.gitkeep

# Data raw and scaler files (large files)
data/raw/*
!data/raw/.gitkeep
data/*.joblib

data/split_data/*/dataset_clean_*/*
!data/split_data/*/dataset_clean_*/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*/*/.ipynb_checkpoints/
*/*/*/.ipynb_checkpoints/

# Virtual environment & IDE settings
.env
.venv/
env/
venv/
ENV/
.vscode/
.idea/

# Output artifacts
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Temporary cache and demo samples
demo_vision_samples/
colab_temp_cache/

# macOS
.DS_Store
