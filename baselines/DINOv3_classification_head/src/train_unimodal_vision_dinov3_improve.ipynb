      "source": [
        "# 4. Scan dataset splits, group images by Fruit ID (e.g., 'durian_002'), and compute Fruit-Level Class Weights\n",
        "RIPENESS_ORDER = [\"Unripe\", \"Ripe\", \"Overripe\"]\n",
        "LABEL_TO_IDX = {name: idx for idx, name in enumerate(RIPENESS_ORDER)}\n",
        "IDX_TO_LABEL = {idx: name for name, idx in LABEL_TO_IDX.items()}\n",
        "\n",
        "def parse_label_from_filename(filename: str) -> Optional[str]:\n",
        "    fn = filename.lower()\n",
        "    if \"_unripe\" in fn or \"-un\" in fn or \"_immature\" in fn:\n",
        "        return \"Unripe\"\n",
        "    elif \"_overripe\" in fn or \"-or\" in fn or \"_senescent\" in fn:\n",
        "        return \"Overripe\"\n",
        "    elif \"_ripe\" in fn or \"-ri\" in fn or \"_mature\" in fn:\n",
        "        return \"Ripe\"\n",
        "    return None\n",
        "\n",
        "def extract_fruit_id(filename: str) -> str:\n",
        "    \"\"\"\n",
        "    Extract the unique fruit identifier prefix from a filename (e.g., 'durian_002_A_Ripe_TOP.jpg' -> 'durian_002').\n",
        "    Handles patterns like 'durian_002', 'durian-002', or general '<prefix>_<number>'.\n",
        "    \"\"\"\n",
        "    stem = os.path.splitext(filename)[0]\n",
        "    match = re.match(r\"^([a-zA-Z]+[_\\-]\\d+)\", stem)\n",
        "    if match:\n",
        "        return match.group(1).lower().replace(\"-\", \"_\")\n",
        "    parts = stem.split(\"_\")\n",
        "    if len(parts) >= 2:\n",
        "        return f\"{parts[0].lower()}_{parts[1].lower()}\"\n",
        "    return stem.lower()\n",
        "\n",
        "def collect_split_images(data_split_dir: str, data_final_dir: str) -> Dict[str, List[Dict]]:\n",
        "    splits_data = {\"train\": [], \"val\": [], \"test\": []}\n",
        "    used_source = None\n",
        "    \n",
        "    # 1. Scan from data/final/\n",
        "    if os.path.isdir(data_final_dir):\n",
        "        for sp in [\"train\", \"val\", \"test\"]:\n",
        "            actual_sp_dir = os.path.join(data_final_dir, \"valid\" if (sp == \"val\" and not os.path.isdir(os.path.join(data_final_dir, \"val\"))) else sp, \"rgb\")\n",
        "            if os.path.isdir(actual_sp_dir):\n",
        "                files = sorted([f for f in os.listdir(actual_sp_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\n",
        "                for f in files:\n",
        "                    lbl = parse_label_from_filename(f)\n",
        "                    if lbl:\n",
        "                        splits_data[sp].append({\n",
        "                            \"filepath\": os.path.join(actual_sp_dir, f),\n",
        "                            \"filename\": f,\n",
        "                            \"fruit_id\": extract_fruit_id(f),\n",
        "                            \"label\": lbl,\n",
        "                            \"label_idx\": LABEL_TO_IDX[lbl],\n",
        "                            \"split\": sp\n",
        "                        })\n",
        "        if sum(len(v) for v in splits_data.values()) > 0:\n",
        "            used_source = \"data/final\"\n",
        "\n",
        "    # 2. Scan from data/split_data/\n",
        "    if sum(len(v) for v in splits_data.values()) == 0 and os.path.isdir(data_split_dir):\n",
        "        for sp in [\"train\", \"val\", \"test\"]:\n",
        "            sp_dir = os.path.join(data_split_dir, sp, \"dataset_clean_rgb\")\n",
        "            if os.path.isdir(sp_dir):\n",
        "                files = sorted([f for f in os.listdir(sp_dir) if f.lower().endswith(('.jpg', '.jpeg', '.png'))])\n",
        "                for f in files:\n",
        "                    lbl = parse_label_from_filename(f)\n",
        "                    if lbl:\n",
        "                        splits_data[sp].append({\n",
        "                            \"filepath\": os.path.join(sp_dir, f),\n",
        "                            \"filename\": f,\n",
        "                            \"fruit_id\": extract_fruit_id(f),\n",
        "                            \"label\": lbl,\n",
        "                            \"label_idx\": LABEL_TO_IDX[lbl],\n",
        "                            \"split\": sp\n",
        "                        })\n",
        "        if sum(len(v) for v in splits_data.values()) > 0:\n",
        "            used_source = \"data/split_data\"\n",
        "\n",
        "    print(f\"[*] Detected data source: {used_source or 'No real images found yet'}\")\n",
        "    return splits_data\n",
        "\n",
        "image_splits = collect_split_images(DATA_SPLIT_DIR, DATA_FINAL_DIR)\n",
        "total_images = sum(len(v) for v in image_splits.values())\n",
        "\n",
        "# Fallback demo cache if environment is empty\n",
        "if total_images == 0:\n",
        "    print(f\"⚠️ Creating synthetic multi-view demo image set at {DEMO_CACHE_DIR}...\")\n",
        "    os.makedirs(DEMO_CACHE_DIR, exist_ok=True)\n",
        "    for sp, num_fruits in [(\"train\", 9), (\"val\", 3), (\"test\", 3)]:\n",
        "        sp_dir = os.path.join(DEMO_CACHE_DIR, sp)\n",
        "        os.makedirs(sp_dir, exist_ok=True)\n",
        "        for f_idx in range(num_fruits):\n",
        "            lbl = RIPENESS_ORDER[f_idx % 3]\n",
        "            fid = f\"durian_{f_idx+1:03d}\"\n",
        "            for v_idx, angle in enumerate([\"TOP\", \"SIDE1\", \"SIDE2\", \"BOTTOM\"]):\n",
        "                fname = f\"{fid}_view{v_idx+1}_{lbl}_{angle}.jpg\"\n",
        "                fpath = os.path.join(sp_dir, fname)\n",
        "                if not os.path.exists(fpath):\n",
        "                    arr = np.random.randint(40, 180, (384, 384, 3), dtype=np.uint8)\n",
        "                    cv2.circle(arr, (192, 192), 120, (50, 120, 40) if lbl==\"Unripe\" else ((30, 140, 180) if lbl==\"Ripe\" else (20, 80, 160)), -1)\n",
        "                    cv2.imwrite(fpath, arr)\n",
        "                image_splits[sp].append({\n",
        "                    \"filepath\": fpath,\n",
        "                    \"filename\": fname,\n",
        "                    \"fruit_id\": fid,\n",
        "                    \"label\": lbl,\n",
        "                    \"label_idx\": LABEL_TO_IDX[lbl],\n",
        "                    \"split\": sp\n",
        "                })\n",
        "\n",
        "# Group individual image records into Multi-View Fruit Bags by fruit_id\n",
        "def group_images_by_fruit(records: List[Dict]) -> List[Dict]:\n",
        "    grouped = defaultdict(list)\n",
        "    for r in records:\n",
        "        grouped[r[\"fruit_id\"]].append(r)\n",
        "    \n",
        "    fruit_bags = []\n",
        "    for fid in sorted(grouped.keys()):\n",
        "        views = sorted(grouped[fid], key=lambda x: x[\"filename\"])\n",
        "        labels = [v[\"label\"] for v in views]\n",
        "        maj_label = max(set(labels), key=labels.count)\n",
        "        fruit_bags.append({\n",
        "            \"fruit_id\": fid,\n",
        "            \"label\": maj_label,\n",
        "            \"label_idx\": LABEL_TO_IDX[maj_label],\n",
        "            \"num_views\": len(views),\n",
        "            \"views\": views,\n",
        "            \"filepaths\": [v[\"filepath\"] for v in views],\n",
        "            \"filenames\": [v[\"filename\"] for v in views],\n",
        "            \"split\": views[0][\"split\"]\n",
        "        })\n",
        "    return fruit_bags\n",
        "\n",
        "fruit_splits = {sp: group_images_by_fruit(image_splits[sp]) for sp in [\"train\", \"val\", \"test\"]}\n",
        "\n",
        "# Display both Image-level and Fruit-level distribution across splits\n",
        "summary_records = []\n",
        "for sp in [\"train\", \"val\", \"test\"]:\n",
        "    df_img = pd.DataFrame(image_splits[sp])\n",
        "    df_frt = pd.DataFrame(fruit_splits[sp])\n",
        "    if len(df_frt) > 0:\n",
        "        f_counts = df_frt[\"label\"].value_counts().to_dict()\n",
        "        avg_views = df_frt[\"num_views\"].mean()\n",
        "        min_views = df_frt[\"num_views\"].min()\n",
        "        max_views = df_frt[\"num_views\"].max()\n",
        "        summary_records.append({\n",
        "            \"Split\": sp,\n",
        "            \"Fruits (Unripe/Ripe/Overripe)\": f\"{f_counts.get('Unripe',0)} / {f_counts.get('Ripe',0)} / {f_counts.get('Overripe',0)}\",\n",
        "            \"Total Fruits\": len(df_frt),\n",
        "            \"Total Images\": len(df_img),\n",
        "            \"Views/Fruit (Min/Avg/Max)\": f\"{min_views} / {avg_views:.1f} / {max_views}\"\n",
        "        })\n",
        "df_summary = pd.DataFrame(summary_records)\n",
        "print(f\"\\n📊 [MULTI-VIEW FRUIT & IMAGE DISTRIBUTION ACROSS SPLITS]\")\n",
        "print(df_summary.to_string(index=False))\n",
        "\n",
        "# --- COMPUTE CLASS WEIGHTS FROM TRAIN SPLIT ---\n",
        "df_train_fruits = pd.DataFrame(fruit_splits[\"train\"])\n",
        "train_fruit_counts = [df_train_fruits[\"label\"].value_counts().get(c, 1) for c in RIPENESS_ORDER]\n",
        "total_train_fruits = sum(train_fruit_counts)\n",
        "\n",
        "# Inverse class-frequency weighting formula: w_c = N / (K * N_c)\n",
        "class_weights_val = [total_train_fruits / (len(RIPENESS_ORDER) * count) for count in train_fruit_counts]\n",
        "CLASS_WEIGHTS = torch.tensor(class_weights_val, dtype=torch.float).to(DEVICE)\n",
        "\n",
        "print(f\"\\n⚖️ [FRUIT-LEVEL CLASS WEIGHTS TO HANDLE IMBALANCE]\")\n",
        "for name, count, w in zip(RIPENESS_ORDER, train_fruit_counts, class_weights_val):\n",
        "    print(f\"  • {name:<9}: {count:>4} fruits -->  Weight: {w:.3f}\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 5. High-resolution 384x384 preprocessing (24x24 Patch16 grid), L-channel CLAHE & Feature-Space Mixup\n",
        "class CLAHETransform:\n",
        "    \"\"\"Apply standard CLAHE on the L (LAB) channel to enhance spine-groove micro-textures.\"\"\"\n",
        "    def __init__(self, clip_limit: float = 2.0, tile_grid_size: Tuple[int, int] = (8, 8)):\n",
        "        self.clahe = cv2.createCLAHE(clipLimit=clip_limit, tileGridSize=tile_grid_size)\n",
        "\n",
        "    def __call__(self, img: Image.Image) -> Image.Image:\n",
        "        np_img = np.array(img)\n",
        "        lab = cv2.cvtColor(np_img, cv2.COLOR_RGB2LAB)\n",
        "        l, a, b = cv2.split(lab)\n",
        "        l_clahe = self.clahe.apply(l)\n",
        "        enhanced_lab = cv2.merge((l_clahe, a, b))\n",
        "        enhanced_rgb = cv2.cvtColor(enhanced_lab, cv2.COLOR_LAB2RGB)\n",
        "        return Image.fromarray(enhanced_rgb)\n",
        "\n",
        "IMAGENET_MEAN = [0.485, 0.456, 0.406]\n",
        "IMAGENET_STD = [0.229, 0.224, 0.225]\n",
        "\n",
        "# 384x384 is divisible by Patch16 (384 / 16 = 24x24 = 576 patches) for clean DINOv3 RoPE/Positional encoding\n",
        "IMAGE_SIZE = 384\n",
        "\n",
        "def get_train_transforms(image_size: int = IMAGE_SIZE) -> transforms.Compose:\n",
        "    return transforms.Compose([\n",
        "        CLAHETransform(clip_limit=2.0, tile_grid_size=(8, 8)),\n",
        "        transforms.RandomResizedCrop(image_size, scale=(0.82, 1.0), ratio=(0.92, 1.08)),\n",
        "        transforms.RandomHorizontalFlip(p=0.5),\n",
        "        transforms.RandomVerticalFlip(p=0.2),\n",
        "        transforms.RandomRotation(degrees=15),\n",
        "        transforms.ColorJitter(brightness=0.12, contrast=0.12, saturation=0.12),\n",
        "        transforms.ToTensor(),\n",
        "        transforms.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n",
        "        transforms.RandomErasing(p=0.15, scale=(0.02, 0.12), ratio=(0.3, 3.3), value='random')\n",
        "    ])\n",
        "\n",
        "def get_eval_transforms(image_size: int = IMAGE_SIZE) -> transforms.Compose:\n",
        "    return transforms.Compose([\n",
        "        CLAHETransform(clip_limit=2.0, tile_grid_size=(8, 8)),\n",
        "        transforms.Resize(int(image_size * 1.08)),\n",
        "        transforms.CenterCrop(image_size),\n",
        "        transforms.ToTensor(),\n",
        "        transforms.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD)\n",
        "    ])\n",
        "\n",
        "def apply_feature_mixup(\n",
        "    bag_embeddings: torch.Tensor,\n",
        "    labels: torch.Tensor,\n",
        "    alpha: float = 0.2\n",
        ") -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, float]:\n",
        "    \"\"\"Mixup directly on aggregated 256-d fruit embeddings F_rgb to smooth fruit-level decision boundaries.\"\"\"\n",
        "    lam = float(np.random.beta(alpha, alpha)) if alpha > 0 else 1.0\n",
        "    batch_size = bag_embeddings.size(0)\n",
        "    index = torch.randperm(batch_size, device=bag_embeddings.device)\n",
        "    mixed_embeddings = lam * bag_embeddings + (1.0 - lam) * bag_embeddings[index]\n",
        "    return mixed_embeddings, labels, labels[index], lam\n"
      ]
