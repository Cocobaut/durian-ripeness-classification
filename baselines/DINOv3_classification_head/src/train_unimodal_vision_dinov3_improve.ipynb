        "# 6. Multi-View Fruit Dataset & Variable-Length Bag Collate DataLoaders\n",
        "class MultiViewDurianDataset(Dataset):\n",
        "    \"\"\"\n",
        "    Each item is a Multi-View Bag of images belonging to the same fruit (e.g., 'durian_002').\n",
        "    During training:\n",
        "      - Randomly subsamples between `min_train_views` and `max_train_views` views per fruit per epoch.\n",
        "      - Prevents the Gated Attention module from memorizing fixed view combinations while keeping\n",
        "        VRAM consumption safe for DINOv3 ViT-Base (85.6M params, 576 tokens/view) at 384x384 resolution.\n",
        "    During evaluation (Val / Test):\n",
        "      - Loads ALL available views of the fruit (up to `max_eval_views`) so Gated Attention pools every angle.\n",
        "    \"\"\"\n",
        "    def __init__(\n",
        "        self,\n",
        "        fruit_bags: List[Dict],\n",
        "        transform: Optional[transforms.Compose] = None,\n",
        "        is_train: bool = True,\n",
        "        min_train_views: int = 4,\n",
        "        max_train_views: int = 6,\n",
        "        max_eval_views: int = 24\n",
        "    ):\n",
        "        self.fruit_bags = fruit_bags\n",
        "        self.transform = transform\n",
        "        self.is_train = is_train\n",
        "        self.min_train_views = min_train_views\n",
        "        self.max_train_views = max_train_views\n",
        "        self.max_eval_views = max_eval_views\n",
        "\n",
        "    def __len__(self) -> int:\n",
        "        return len(self.fruit_bags)\n",
        "\n",
        "    def __getitem__(self, idx: int) -> Dict:\n",
        "        bag = self.fruit_bags[idx]\n",
        "        views = bag[\"views\"]\n",
        "        total_v = len(views)\n",
        "\n",
        "        if self.is_train:\n",
        "            low_k = min(total_v, self.min_train_views)\n",
        "            high_k = min(total_v, self.max_train_views)\n",
        "            k = random.randint(low_k, high_k) if high_k > low_k else high_k\n",
        "            selected_views = random.sample(views, k)\n",
        "        else:\n",
        "            selected_views = views[:self.max_eval_views]\n",
        "\n",
        "        tensors = []\n",
        "        filenames = []\n",
        "        for v in selected_views:\n",
        "            with Image.open(v[\"filepath\"]) as img:\n",
        "                rgb_img = img.convert(\"RGB\")\n",
        "            tensor_img = self.transform(rgb_img) if self.transform else transforms.ToTensor()(rgb_img)\n",
        "            tensors.append(tensor_img)\n",
        "            filenames.append(v[\"filename\"])\n",
        "\n",
        "        views_tensor = torch.stack(tensors, dim=0)  # [N_i, 3, H, W]\n",
        "        return {\n",
        "            \"views\": views_tensor,\n",
        "            \"label_idx\": bag[\"label_idx\"],\n",
        "            \"fruit_id\": bag[\"fruit_id\"],\n",
        "            \"filenames\": filenames,\n",
        "            \"num_views\": len(tensors)\n",
        "        }\n",
        "\n",
        "def multiview_collate_fn(batch: List[Dict]) -> Dict:\n",
        "    \"\"\"\n",
        "    Collates a batch of variable-length multi-view fruit bags into:\n",
        "      - flat_images: Tensor [sum(N_i), 3, H, W] for single-pass DINOv3 backbone execution\n",
        "      - view_counts: List[int] = [N_1, N_2, ..., N_B] to split features back per fruit\n",
        "      - labels     : Tensor [B] fruit-level ground-truth class indices\n",
        "      - fruit_ids  : List[str] of length B\n",
        "      - filenames  : List[List[str]] of length B\n",
        "    \"\"\"\n",
        "    flat_images = torch.cat([item[\"views\"] for item in batch], dim=0)\n",
        "    view_counts = [item[\"num_views\"] for item in batch]\n",
        "    labels = torch.tensor([item[\"label_idx\"] for item in batch], dtype=torch.long)\n",
        "    fruit_ids = [item[\"fruit_id\"] for item in batch]\n",
        "    filenames = [item[\"filenames\"] for item in batch]\n",
        "    return {\n",
        "        \"flat_images\": flat_images,\n",
        "        \"view_counts\": view_counts,\n",
        "        \"labels\": labels,\n",
        "        \"fruit_ids\": fruit_ids,\n",
        "        \"filenames\": filenames\n",
        "    }\n",
        "\n",
        "# DINOv3 ViT-Base has 85.6M params: FRUIT_BATCH_SIZE = 3 fruits (~15-18 views of 384x384 per pass) fits comfortably in Colab GPU VRAM\n",
        "FRUIT_BATCH_SIZE = 3 if torch.cuda.is_available() else 1\n",
        "EVAL_FRUIT_BATCH_SIZE = 2 if torch.cuda.is_available() else 1\n",
        "# NUM_WORKERS = 2 + persistent_workers = True prevents Python 3.13 Colab _MultiProcessingDataLoaderIter.__del__ AssertionError\n",
        "NUM_WORKERS = 2 if torch.cuda.is_available() else 0\n",
        "\n",
        "train_dataset = MultiViewDurianDataset(\n",
        "    fruit_splits[\"train\"],\n",
        "    transform=get_train_transforms(IMAGE_SIZE),\n",
        "    is_train=True,\n",
        "    min_train_views=4,\n",
        "    max_train_views=6\n",
        ")\n",
        "val_dataset = MultiViewDurianDataset(\n",
        "    fruit_splits[\"val\"],\n",
        "    transform=get_eval_transforms(IMAGE_SIZE),\n",
        "    is_train=False,\n",
        "    max_eval_views=24\n",
        ")\n",
        "test_dataset = MultiViewDurianDataset(\n",
        "    fruit_splits[\"test\"],\n",
        "    transform=get_eval_transforms(IMAGE_SIZE),\n",
        "    is_train=False,\n",
        "    max_eval_views=24\n",
        ")\n",
        "\n",
        "train_loader = DataLoader(\n",
        "    train_dataset,\n",
        "    batch_size=FRUIT_BATCH_SIZE,\n",
        "    shuffle=True,\n",
        "    num_workers=NUM_WORKERS,\n",
        "    pin_memory=(DEVICE.type == \"cuda\"),\n",
        "    persistent_workers=(NUM_WORKERS > 0),\n",
        "    collate_fn=multiview_collate_fn,\n",
        "    drop_last=(len(train_dataset) > FRUIT_BATCH_SIZE)\n",
        ")\n",
        "\n",
        "val_loader = DataLoader(\n",
        "    val_dataset,\n",
        "    batch_size=EVAL_FRUIT_BATCH_SIZE,\n",
        "    shuffle=False,\n",
        "    num_workers=NUM_WORKERS,\n",
        "    pin_memory=(DEVICE.type == \"cuda\"),\n",
        "    persistent_workers=(NUM_WORKERS > 0),\n",
        "    collate_fn=multiview_collate_fn\n",
        ")\n",
        "\n",
        "test_loader = DataLoader(\n",
        "    test_dataset,\n",
        "    batch_size=EVAL_FRUIT_BATCH_SIZE,\n",
        "    shuffle=False,\n",
        "    num_workers=NUM_WORKERS,\n",
        "    pin_memory=(DEVICE.type == \"cuda\"),\n",
        "    persistent_workers=(NUM_WORKERS > 0),\n",
        "    collate_fn=multiview_collate_fn\n",
        ")\n",
        "\n",
        "print(f\"✅ Multi-View Fruit DataLoaders ready at {IMAGE_SIZE}x{IMAGE_SIZE} (num_workers={NUM_WORKERS}, persistent_workers={NUM_WORKERS > 0}):\")\n",
        "print(f\"  • Train: {len(train_dataset)} fruits ({len(image_splits['train'])} total views | {len(train_loader)} fruit-batches)\")\n",
        "print(f\"  • Val  : {len(val_dataset)} fruits ({len(image_splits['val'])} total views | {len(val_loader)} fruit-batches)\")\n",
        "print(f\"  • Test : {len(test_dataset)} fruits ({len(image_splits['test'])} total views | {len(test_loader)} fruit-batches)\")\n"
      ]
    },
