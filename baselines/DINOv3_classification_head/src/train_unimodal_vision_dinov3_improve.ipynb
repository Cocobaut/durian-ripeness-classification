      "source": [
        "# 12. Comprehensive Test Evaluation: Gated Attention Fruit-Level Pooling, Per-View TTA & Attention Visualization\n",
        "USE_TTA = True  # Multi-crop/flip Test-Time Augmentation on each view before Gated Attention Pooling\n",
        "\n",
        "if os.path.isfile(BEST_FULL_CHECKPOINT_PATH):\n",
        "    print(f\"[*] 🔄 Loading best Multi-View DINOv3 checkpoint from: {BEST_FULL_CHECKPOINT_PATH}...\")\n",
        "    best_cp = torch.load(BEST_FULL_CHECKPOINT_PATH, map_location=DEVICE)\n",
        "    model.load_state_dict(best_cp[\"model_state_dict\"])\n",
        "    print(f\"✅ Successfully loaded best Checkpoint at Epoch {best_cp.get('epoch', 'N/A')} \"\n",
        "          f\"(Val Loss: {best_cp.get('best_val_loss', 0.0):.4f} | Val Fruit Macro-F1: {best_cp.get('best_val_f1', 0.0):.4f})\")\n",
        "elif os.path.isfile(BACKBONE_PROJ_BEST_PATH) and os.path.isfile(CLASSIFICATION_HEAD_BEST_PATH):\n",
        "    print(\"[*] 🔄 Loading separate fine-tuned 256-d DINOv3 Extractor and Classification Head checkpoints...\")\n",
        "    bb_cp = torch.load(BACKBONE_PROJ_BEST_PATH, map_location=DEVICE)\n",
        "    hd_cp = torch.load(CLASSIFICATION_HEAD_BEST_PATH, map_location=DEVICE)\n",
        "    model.backbone.load_state_dict(bb_cp[\"backbone_state_dict\"])\n",
        "    model.projection.load_state_dict(bb_cp[\"projection_state_dict\"])\n",
        "    model.gated_attention.load_state_dict(bb_cp[\"gated_attention_state_dict\"])\n",
        "    model.classification_head.load_state_dict(hd_cp[\"classification_head_state_dict\"])\n",
        "    print(\"✅ Loaded separate DINOv3 Extractor and Head weights!\")\n",
        "else:\n",
        "    print(\"⚠️ Using current in-memory model weights.\")\n",
        "\n",
        "model.eval()\n",
        "\n",
        "@torch.no_grad()\n",
        "def extract_tta_view_embeddings(model: DINOv3MultiViewGatedAttention, flat_images: torch.Tensor, use_tta: bool = True) -> torch.Tensor:\n",
        "    \"\"\"Extract 256-d view embeddings f_i with optional 3-view TTA (Original + Horizontal Flip + 95% Central Zoom).\"\"\"\n",
        "    f_orig = model.extract_view_embeddings(flat_images)\n",
        "    if not use_tta:\n",
        "        return f_orig\n",
        "\n",
        "    # TTA 2: Horizontal Flip\n",
        "    f_hflip = model.extract_view_embeddings(torch.flip(flat_images, dims=[3]))\n",
        "    # TTA 3: Slight 95% Central Zoom\n",
        "    pad = max(1, int(flat_images.shape[-1] * 0.025))\n",
        "    cropped = flat_images[:, :, pad:-pad, pad:-pad]\n",
        "    zoomed = F.interpolate(cropped, size=flat_images.shape[-2:], mode=\"bilinear\", align_corners=False)\n",
        "    f_zoom = model.extract_view_embeddings(zoomed)\n",
        "\n",
        "    return 0.50 * f_orig + 0.30 * f_hflip + 0.20 * f_zoom\n",
        "\n",
        "test_bag_loss = 0.0\n",
        "total_test_fruits = 0\n",
        "\n",
        "fruit_eval_records = []\n",
        "image_eval_records = []\n",
        "\n",
        "with torch.no_grad():\n",
        "    for batch in tqdm(test_loader, desc=\"Evaluating Multi-View Test Fruits\"):\n",
        "        flat_images = batch[\"flat_images\"].to(DEVICE)\n",
        "        view_counts = batch[\"view_counts\"]\n",
        "        fruit_targets = batch[\"labels\"].to(DEVICE)\n",
        "        fruit_ids = batch[\"fruit_ids\"]\n",
        "        filenames_per_fruit = batch[\"filenames\"]\n",
        "\n",
        "        with torch.amp.autocast('cuda', enabled=(DEVICE.type == 'cuda')):\n",
        "            # 1. Extract TTA-enhanced 256-d view embeddings f_i in R^{256}\n",
        "            f_all_views = extract_tta_view_embeddings(model, flat_images, use_tta=USE_TTA)\n",
        "            view_logits = model.classification_head(f_all_views)\n",
        "            view_probs = F.softmax(view_logits, dim=1).cpu().numpy()\n",
        "\n",
        "            # 2. Pool each fruit's views via Lightweight Gated Attention: F_rgb = sum_i a_i f_i\n",
        "            F_rgb_batch, attn_weights_list = model.pool_fruit_bags(f_all_views, view_counts)\n",
        "            bag_logits = model.classification_head(F_rgb_batch)\n",
        "            bag_loss = criterion(bag_logits, fruit_targets)\n",
        "            bag_probs = F.softmax(bag_logits, dim=1).cpu().numpy()\n",
        "\n",
        "        batch_fruits = fruit_targets.size(0)\n",
        "        test_bag_loss += bag_loss.item() * batch_fruits\n",
        "        total_test_fruits += batch_fruits\n",
        "\n",
        "        # Split view probabilities per fruit to record detailed image-level & attention weights\n",
        "        idx_offset = 0\n",
        "        for b_i in range(batch_fruits):\n",
        "            n_v = view_counts[b_i]\n",
        "            fid = fruit_ids[b_i]\n",
        "            t_idx = int(fruit_targets[b_i].item())\n",
        "            f_prob = bag_probs[b_i]\n",
        "            f_pred = int(np.argmax(f_prob))\n",
        "            attn_w = attn_weights_list[b_i].cpu().numpy()\n",
        "            fnames = filenames_per_fruit[b_i]\n",
        "\n",
        "            top_view_idx = int(np.argmax(attn_w))\n",
        "            fruit_eval_records.append({\n",
        "                \"fruit_id\": fid,\n",
        "                \"num_views\": n_v,\n",
        "                \"true_label\": RIPENESS_ORDER[t_idx],\n",
        "                \"pred_label\": RIPENESS_ORDER[f_pred],\n",
        "                \"true_idx\": t_idx,\n",
        "                \"pred_idx\": f_pred,\n",
        "                \"prob_Unripe\": float(f_prob[0]),\n",
        "                \"prob_Ripe\": float(f_prob[1]),\n",
        "                \"prob_Overripe\": float(f_prob[2]),\n",
        "                \"most_attended_view\": fnames[top_view_idx],\n",
        "                \"max_attention_weight\": float(attn_w[top_view_idx]),\n",
        "                \"min_attention_weight\": float(np.min(attn_w)),\n",
        "                \"is_correct\": bool(t_idx == f_pred)\n",
        "            })\n",
        "\n",
        "            for v_j in range(n_v):\n",
        "                v_prob = view_probs[idx_offset + v_j]\n",
        "                v_pred = int(np.argmax(v_prob))\n",
        "                image_eval_records.append({\n",
        "                    \"filename\": fnames[v_j],\n",
        "                    \"fruit_id\": fid,\n",
        "                    \"true_label\": RIPENESS_ORDER[t_idx],\n",
        "                    \"view_pred_label\": RIPENESS_ORDER[v_pred],\n",
        "                    \"fruit_attn_pred_label\": RIPENESS_ORDER[f_pred],\n",
        "                    \"true_idx\": t_idx,\n",
        "                    \"view_pred_idx\": v_pred,\n",
        "                    \"attention_weight\": float(attn_w[v_j]),\n",
        "                    \"prob_Unripe\": float(v_prob[0]),\n",
        "                    \"prob_Ripe\": float(v_prob[1]),\n",
        "                    \"prob_Overripe\": float(v_prob[2]),\n",
        "                    \"is_correct\": bool(t_idx == v_pred)\n",
        "                })\n",
        "            idx_offset += n_v\n",
        "\n",
        "test_bag_loss /= max(1, total_test_fruits)\n",
        "df_fruit_results = pd.DataFrame(fruit_eval_records)\n",
        "df_image_results = pd.DataFrame(image_eval_records)\n",
        "\n",
        "# 1. FRUIT-LEVEL GATED ATTENTION EVALUATION RESULTS\n",
        "fruit_y_true = df_fruit_results[\"true_idx\"].values\n",
        "fruit_y_pred = df_fruit_results[\"pred_idx\"].values\n",
        "fruit_acc = accuracy_score(fruit_y_true, fruit_y_pred)\n",
        "fruit_macro_f1 = f1_score(fruit_y_true, fruit_y_pred, average=\"macro\", zero_division=0)\n",
        "\n",
        "# 2. IMAGE-LEVEL (SINGLE-VIEW) EVALUATION RESULTS\n",
        "img_y_true = df_image_results[\"true_idx\"].values\n",
        "img_y_pred = df_image_results[\"view_pred_idx\"].values\n",
        "img_acc = accuracy_score(img_y_true, img_y_pred)\n",
        "img_macro_f1 = f1_score(img_y_true, img_y_pred, average=\"macro\", zero_division=0)\n",
        "\n",
        "print(\"\\n\" + \"=\"*74)\n",
        "print(f\"🍈 MULTI-VIEW DINOV3 GATED ATTENTION FRUIT-LEVEL RESULTS ({len(df_fruit_results)} FRUITS | TTA={'ON' if USE_TTA else 'OFF'})\")\n",
        "print(\"=\"*74)\n",
        "print(f\"  • Test Bag Loss                        : {test_bag_loss:.4f}\")\n",
        "print(f\"  • Fruit-Level Accuracy (Gated Attention): {fruit_acc * 100:.2f} %\")\n",
        "print(f\"  • Fruit-Level Macro-F1 (Gated Attention): {fruit_macro_f1:.4f}\")\n",
        "print(\"=\"*74)\n",
        "\n",
        "fruit_report_str = classification_report(fruit_y_true, fruit_y_pred, target_names=RIPENESS_ORDER, digits=4, zero_division=0)\n",
        "fruit_report_dict = classification_report(fruit_y_true, fruit_y_pred, target_names=RIPENESS_ORDER, digits=4, zero_division=0, output_dict=True)\n",
        "print(\"\\n📋 [PER-CLASS FRUIT-LEVEL CLASSIFICATION REPORT (GATED ATTENTION)]\")\n",
        "print(fruit_report_str)\n",
        "\n",
        "print(\"=\"*74)\n",
        "print(f\"🖼️ SINGLE-VIEW (IMAGE-LEVEL) AUXILIARY TEST RESULTS ({len(df_image_results)} IMAGES)\")\n",
        "print(\"=\"*74)\n",
        "print(f\"  • Image-Level Accuracy (Single-View)   : {img_acc * 100:.2f} %\")\n",
        "print(f\"  • Image-Level Macro-F1 (Single-View)   : {img_macro_f1:.4f}\")\n",
        "print(\"=\"*74 + \"\\n\")\n",
        "\n",
        "# Save detailed CSVs and JSON summary in RESULTS_DIR\n",
        "csv_fruit_path = os.path.join(RESULTS_DIR, \"test_fruit_level_gated_attention.csv\")\n",
        "df_fruit_results.to_csv(csv_fruit_path, index=False, encoding=\"utf-8\")\n",
        "print(f\"💾 Saved Multi-View Gated Attention fruit predictions CSV at: {csv_fruit_path}\")\n",
        "\n",
        "csv_img_path = os.path.join(RESULTS_DIR, \"test_view_level_attention_weights.csv\")\n",
        "df_image_results.to_csv(csv_img_path, index=False, encoding=\"utf-8\")\n",
        "print(f\"💾 Saved per-view predictions & Gated Attention weights CSV at: {csv_img_path}\")\n",
        "\n",
        "metrics_summary = {\n",
        "    \"model\": f\"Multi-View DINOv3 ({model.model_name}) + 256-d Projection + Lightweight Gated Attention (Ilse et al., D=128) + Classification Head\",\n",
        "    \"image_size\": IMAGE_SIZE,\n",
        "    \"backbone_dim\": int(model.backbone_dim),\n",
        "    \"embed_dim\": int(model.embed_dim),\n",
        "    \"attn_hidden_dim\": int(model.attn_hidden_dim),\n",
        "    \"use_tta\": USE_TTA,\n",
        "    \"best_epoch\": int(best_cp.get(\"epoch\", best_epoch)) if 'best_cp' in locals() else int(best_epoch),\n",
        "    \"test_bag_loss\": float(test_bag_loss),\n",
        "    \"fruit_level_accuracy\": float(fruit_acc),\n",
        "    \"fruit_level_macro_f1\": float(fruit_macro_f1),\n",
        "    \"image_level_accuracy\": float(img_acc),\n",
        "    \"image_level_macro_f1\": float(img_macro_f1),\n",
        "    \"total_test_fruits\": int(len(df_fruit_results)),\n",
        "    \"total_test_images\": int(len(df_image_results)),\n",
        "    \"fruit_classification_report\": fruit_report_dict,\n",
        "    \"timestamp\": time.strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "}\n",
        "json_summary_path = os.path.join(RESULTS_DIR, \"test_metrics_summary_multiview.json\")\n",
        "with open(json_summary_path, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(metrics_summary, f, indent=2, ensure_ascii=False)\n",
        "print(f\"💾 Saved Multi-View test metrics summary JSON at: {json_summary_path}\")\n",
        "\n",
        "# 3. PLOT SIDE-BY-SIDE CONFUSION MATRICES (FRUIT-LEVEL GATED ATTENTION vs SINGLE-VIEW)\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "cm_fruit = confusion_matrix(fruit_y_true, fruit_y_pred)\n",
        "sns.heatmap(cm_fruit, annot=True, fmt=\"d\", cmap=\"Greens\", ax=axes[0],\n",
        "            xticklabels=RIPENESS_ORDER, yticklabels=RIPENESS_ORDER, cbar=False,\n",
        "            annot_kws={\"size\": 13, \"weight\": \"bold\"})\n",
        "axes[0].set_title(f\"DINOv3 Gated Attention (Fruit-Level)\\nAccuracy: {fruit_acc*100:.1f}% | Macro-F1: {fruit_macro_f1:.3f}\", fontweight=\"bold\")\n",
        "axes[0].set_xlabel(\"Predicted\", fontweight=\"bold\")\n",
        "axes[0].set_ylabel(\"Ground Truth\", fontweight=\"bold\")\n",
        "\n",
        "cm_img = confusion_matrix(img_y_true, img_y_pred)\n",
        "sns.heatmap(cm_img, annot=True, fmt=\"d\", cmap=\"Blues\", ax=axes[1],\n",
        "            xticklabels=RIPENESS_ORDER, yticklabels=RIPENESS_ORDER, cbar=False,\n",
        "            annot_kws={\"size\": 13, \"weight\": \"bold\"})\n",
        "axes[1].set_title(f\"Single-View Auxiliary Prediction (Image-Level)\\nAccuracy: {img_acc*100:.1f}% | Macro-F1: {img_macro_f1:.3f}\", fontweight=\"bold\")\n",
        "axes[1].set_xlabel(\"Predicted\", fontweight=\"bold\")\n",
        "axes[1].set_ylabel(\"Ground Truth\", fontweight=\"bold\")\n",
        "\n",
        "plt.tight_layout()\n",
        "cm_fig_path = os.path.join(RESULTS_DIR, \"test_confusion_matrices_multiview.png\")\n",
        "plt.savefig(cm_fig_path, dpi=200)\n",
        "plt.show()\n",
        "print(f\"📊 Saved Multi-View confusion matrices at: {cm_fig_path}\")\n",
        "\n",
        "# 4. VISUALIZE GATED ATTENTION WEIGHTS ACROSS VIEWS OF A SAMPLE TEST FRUIT\n",
        "if len(df_fruit_results) > 0:\n",
        "    sample_fid = df_fruit_results.iloc[0][\"fruit_id\"]\n",
        "    sample_views_df = df_image_results[df_image_results[\"fruit_id\"] == sample_fid].sort_values(\"attention_weight\", ascending=False)\n",
        "    top_k_views = sample_views_df.head(min(5, len(sample_views_df)))\n",
        "\n",
        "    fig, axes = plt.subplots(1, len(top_k_views), figsize=(3.6 * len(top_k_views), 4.0))\n",
        "    if len(top_k_views) == 1:\n",
        "        axes = [axes]\n",
        "    for ax, (_, row) in zip(axes, top_k_views.iterrows()):\n",
        "        img_path = None\n",
        "        for sp_item in image_splits[\"test\"]:\n",
        "            if sp_item[\"filename\"] == row[\"filename\"]:\n",
        "                img_path = sp_item[\"filepath\"]\n",
        "                break\n",
        "        if img_path and os.path.isfile(img_path):\n",
        "            disp_img = cv2.imread(img_path)\n",
        "            disp_img = cv2.cvtColor(disp_img, cv2.COLOR_BGR2RGB)\n",
        "            ax.imshow(disp_img)\n",
        "        ax.set_title(f\"{row['filename'][:18]}\\nAttn a_i = {row['attention_weight']:.3f}\\nView Pred: {row['view_pred_label']}\",\n",
        "                     fontsize=9.5, fontweight=\"bold\", color=\"#1b5e20\" if row[\"is_correct\"] else \"#b71c1c\")\n",
        "        ax.axis(\"off\")\n",
        "    f_row = df_fruit_results.iloc[0]\n",
        "    plt.suptitle(\n",
        "        f\"DINOv3 Gated Attention Weights for Fruit '{sample_fid}' (True: {f_row['true_label']} | Pooled Pred: {f_row['pred_label']})\",\n",
        "        fontweight=\"bold\", y=1.03\n",
        "    )\n",
        "    plt.tight_layout()\n",
        "    attn_fig_path = os.path.join(RESULTS_DIR, \"test_gated_attention_views_sample.png\")\n",
        "    plt.savefig(attn_fig_path, dpi=200, bbox_inches=\"tight\")\n",
        "    plt.show()\n",
        "    print(f\"📊 Saved Gated Attention view-weight visualization at: {attn_fig_path}\")\n"
      ]
