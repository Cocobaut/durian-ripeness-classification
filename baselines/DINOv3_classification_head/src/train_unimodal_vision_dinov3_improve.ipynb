        "        print(f\"[*] 🔄 Resuming from latest Multi-View DINOv3 checkpoint: {LAST_FULL_CHECKPOINT_PATH}...\")\n",
        "        cp = torch.load(LAST_FULL_CHECKPOINT_PATH, map_location=DEVICE)\n",
        "        model.load_state_dict(cp[\"model_state_dict\"])\n",
        "        optimizer.load_state_dict(cp[\"optimizer_state_dict\"])\n",
