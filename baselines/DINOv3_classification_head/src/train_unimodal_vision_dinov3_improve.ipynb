        "\n",
        "    # 2. Fruit-Level & View-Level Accuracy Curves\n",
        "    axes[1].plot(epochs_ran, history[\"train_fruit_acc\"], label=\"Train Fruit Acc\", marker=\"o\", linewidth=2, color=\"#2ca02c\")\n",
