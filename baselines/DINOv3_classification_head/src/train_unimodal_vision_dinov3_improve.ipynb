        "# 9. Non-Overwriting Checkpoint Management, Periodic Saving & Early Stopping (Monitoring Fruit-Level Val Macro-F1)\n",
        "FORCE_FRESH_START = True  # SET TRUE TO START CLEAN TRAINING; SET FALSE TO RESUME FROM LAST CHECKPOINT\n",
        "\n",
        "class EarlyStopping:\n",
        "    \"\"\"Stop training automatically when Fruit-Level Val Macro-F1 fails to improve for 'patience' epochs after 'min_epochs'.\"\"\"\n",
        "    def __init__(self, patience: int = 12, min_delta: float = 1e-4, min_epochs: int = 10):\n",
        "        self.patience = patience\n",
        "        self.min_delta = min_delta\n",
        "        self.min_epochs = min_epochs\n",
        "        self.counter = 0\n",
        "        self.best_score = -1.0\n",
        "        self.early_stop = False\n",
        "\n",
        "    def __call__(self, current_val_f1: float, epoch: int) -> bool:\n",
        "        if current_val_f1 > (self.best_score + self.min_delta):\n",
        "            self.best_score = current_val_f1\n",
        "            self.counter = 0\n",
        "            return True  # Improved -> Save best checkpoints\n",
        "        else:\n",
        "            if epoch >= self.min_epochs:\n",
        "                self.counter += 1\n",
        "                if self.counter >= self.patience:\n",
        "                    self.early_stop = True\n",
        "            return False\n",
        "\n",
        "def save_full_checkpoint(\n",
        "    model_obj: DINOv3MultiViewGatedAttention,\n",
        "    state_dict_optimizer,\n",
        "    state_dict_scheduler,\n",
        "    epoch: int,\n",
