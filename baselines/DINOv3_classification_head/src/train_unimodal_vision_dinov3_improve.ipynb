        "# 7. Initialize Multi-View DINOv3 Backbone + 768->256 Projection + Lightweight Gated Attention + Classification Head\n",
        "#    - Reuses cached raw DINOv3 weights from `dinov3_pretrained_raw_weights.pt` in Google Drive.\n",
        "#    - Never overwrites existing single-view or raw backbone `.pt` files.\n",
        "\n",
        "DINOV3_CANDIDATE_MODELS = [\n",
        "    \"vit_base_patch16_dinov3.lvd1689m\",\n",
        "    \"convnext_base.dinov3_lvd1689m\",\n",
        "    \"vit_base_patch14_dinov2.lvd142m\"\n",
        "]\n",
        "\n",
        "class LightweightGatedAttention(nn.Module):\n",
        "    \"\"\"\n",
        "    Lightweight Gated Attention Mechanism (Ilse et al., 2018):\n",
        "      a_i = exp(w^T (tanh(V f_i) * sigma(U f_i))) / sum_j exp(w^T (tanh(V f_j) * sigma(U f_j)))\n",
        "      F_rgb = sum_{i=1}^N a_i f_i  in R^{256}\n",
        "    \"\"\"\n",
        "    def __init__(self, embed_dim: int = 256, hidden_dim: int = 128, attn_dropout: float = 0.1):\n",
        "        super().__init__()\n",
        "        self.V = nn.Linear(embed_dim, hidden_dim)\n",
        "        self.U = nn.Linear(embed_dim, hidden_dim)\n",
        "        self.drop = nn.Dropout(p=attn_dropout)\n",
        "        self.w = nn.Linear(hidden_dim, 1, bias=False)\n",
        "\n",
        "    def forward(self, f_views: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:\n",
        "        \"\"\"\n",
        "        Args:\n",
        "            f_views: Tensor of shape [N, 256] representing N views of a single fruit.\n",
        "        Returns:\n",
        "            F_rgb       : Aggregated fruit representation [256]\n",
        "            attn_weights: Normalized attention weights [N] summing to 1.0\n",
        "        \"\"\"\n",
        "        # tanh(V f_i) (*) sigma(U f_i) -> [N, D]\n",
        "        gated_hidden = torch.tanh(self.V(f_views)) * torch.sigmoid(self.U(f_views))\n",
        "        gated_hidden = self.drop(gated_hidden)\n",
        "        # Raw attention scores: w^T (...) -> [N, 1]\n",
        "        scores = self.w(gated_hidden)\n",
        "        # Softmax across the N views of the fruit\n",
        "        attn_weights = F.softmax(scores, dim=0)  # [N, 1]\n",
        "        # Weighted sum: F_rgb = sum_{i=1}^N a_i f_i -> [256]\n",
        "        F_rgb = torch.sum(attn_weights * f_views, dim=0)\n",
        "        return F_rgb, attn_weights.squeeze(-1)\n",
        "\n",
        "\n",
        "class DINOv3MultiViewGatedAttention(nn.Module):\n",
        "    \"\"\"\n",
        "    End-to-End Multi-View DINOv3 Durian Ripeness Classifier:\n",
        "      1. Backbone: DINOv3 ViT-Base ('vit_base_patch16_dinov3.lvd1689m', fc removed) -> h_i in R^{768}\n",
        "      2. Compression Projection Block:\n",
        "           f_i = Dropout(GELU(LayerNorm(W_proj h_i))) in R^{256}\n",
        "      3. Lightweight Gated Attention Pooling (Ilse et al., D=128):\n",
        "           F_rgb = sum_{i=1}^N a_i f_i in R^{256}\n",
        "      4. Classification Head: LayerNorm(256) -> Dropout -> Linear(256 -> 3)\n",
        "    \"\"\"\n",
        "    def __init__(\n",
        "        self,\n",
        "        num_classes: int = 3,\n",
        "        embed_dim: int = 256,\n",
        "        attn_hidden_dim: int = 128,\n",
        "        drop_path_rate: float = 0.2,\n",
        "        proj_dropout: float = 0.25,\n",
        "        head_dropout: float = 0.25,\n",
        "        raw_cache_path: str = RAW_PRETRAINED_BACKBONE_PATH\n",
        "    ):\n",
        "        super().__init__()\n",
        "        self.backbone = None\n",
        "        self.model_name = None\n",
        "\n",
        "        # 1. Check if raw pretrained DINOv3 weights are already cached in Google Drive\n",
        "        if os.path.isfile(raw_cache_path):\n",
        "            try:\n",
        "                print(f\"[*] ⚡ Found cached DINOv3 pretrained weights in Drive: {raw_cache_path}\")\n",
        "                cached_payload = torch.load(raw_cache_path, map_location=\"cpu\")\n",
        "                cached_arch = cached_payload.get(\"model_name\", DINOV3_CANDIDATE_MODELS[0])\n",
        "                create_kwargs = {\"pretrained\": False, \"num_classes\": 0, \"drop_path_rate\": drop_path_rate}\n",
        "                if cached_arch.startswith(\"vit_\"):\n",
        "                    create_kwargs[\"dynamic_img_size\"] = True\n",
        "                self.backbone = timm.create_model(cached_arch, **create_kwargs)\n",
        "                self.backbone.load_state_dict(cached_payload[\"backbone_state_dict\"], strict=False)\n",
        "                self.model_name = cached_arch\n",
        "                print(f\"✅ Loaded DINOv3 ('{self.model_name}') from Drive cache without internet download!\")\n",
        "            except Exception as e:\n",
        "                print(f\"⚠️ Cached DINOv3 load warning ({e}), falling back to Hub download...\")\n",
        "                self.backbone = None\n",
        "\n",
        "        # 2. If not cached yet, download from HuggingFace / timm and immediately cache to Drive\n",
        "        if self.backbone is None:\n",
        "            for candidate in DINOV3_CANDIDATE_MODELS:\n",
        "                try:\n",
        "                    print(f\"[*] Downloading pre-trained DINOv3 weights: '{candidate}'...\")\n",
        "                    create_kwargs = {\"pretrained\": True, \"num_classes\": 0, \"drop_path_rate\": drop_path_rate}\n",
        "                    if candidate.startswith(\"vit_\"):\n",
        "                        create_kwargs[\"dynamic_img_size\"] = True\n",
        "                    self.backbone = timm.create_model(candidate, **create_kwargs)\n",
        "                    self.model_name = candidate\n",
        "                    torch.save({\n",
        "                        \"model_name\": self.model_name,\n",
        "                        \"backbone_state_dict\": self.backbone.state_dict(),\n",
        "                        \"feature_dim\": self.backbone.num_features,\n",
        "                        \"saved_at\": time.strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "                    }, raw_cache_path)\n",
        "                    print(f\"💾 Cached raw DINOv3 weights to Drive at: {raw_cache_path}\")\n",
        "                    break\n",
        "                except Exception as e:\n",
        "                    print(f\"⚠️ Could not load '{candidate}': {e}\")\n",
        "\n",
        "        if self.backbone is None:\n",
        "            raise RuntimeError(\"Failed to initialize DINOv3 backbone. Please ensure `timm` is updated (`pip install -U timm`).\")\n",
        "\n",
        "        self.backbone_dim = self.backbone.num_features  # 768 for ViT-Base / 1024 for ConvNeXt-Base\n",
        "        self.embed_dim = embed_dim                      # 256\n",
        "        self.attn_hidden_dim = attn_hidden_dim          # 128\n",
        "\n",
        "        # 3. Feature Projection & Compression Block: f_i = Dropout(GELU(LayerNorm(W_proj h_i))) in R^{256}\n",
        "        self.projection = nn.Sequential(\n",
        "            nn.Linear(self.backbone_dim, self.embed_dim),\n",
        "            nn.LayerNorm(self.embed_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(p=proj_dropout)\n",
        "        )\n",
        "\n",
        "        # 4. Lightweight Gated Attention (Ilse et al.) on 256-d compressed space\n",
        "        self.gated_attention = LightweightGatedAttention(\n",
        "            embed_dim=self.embed_dim,\n",
        "            hidden_dim=self.attn_hidden_dim,\n",
        "            attn_dropout=0.1\n",
        "        )\n",
        "\n",
        "        # 5. Fruit-Level Classification Head on aggregated F_rgb in R^{256}\n",
        "        self.classification_head = nn.Sequential(\n",
        "            nn.LayerNorm(self.embed_dim),\n",
        "            nn.Dropout(p=head_dropout),\n",
        "            nn.Linear(self.embed_dim, num_classes)\n",
        "        )\n",
        "\n",
        "    def extract_view_embeddings(self, flat_images: torch.Tensor) -> torch.Tensor:\n",
        "        \"\"\"Pass individual views I_i through DINOv3 + 256-d Projection Block -> f_i in R^{256}.\"\"\"\n",
        "        h = self.backbone(flat_images)       # [Total_Views, 768]\n",
        "        f = self.projection(h)               # [Total_Views, 256]\n",
        "        return f\n",
        "\n",
        "    def pool_fruit_bags(\n",
        "        self,\n",
        "        f_all_views: torch.Tensor,\n",
        "        view_counts: List[int]\n",
        "    ) -> Tuple[torch.Tensor, List[torch.Tensor]]:\n",
        "        \"\"\"Split flat view embeddings by fruit and pool each fruit bag via Gated Attention.\"\"\"\n",
        "        bag_chunks = torch.split(f_all_views, view_counts, dim=0)\n",
        "        pooled_fruits = []\n",
        "        attn_weights_list = []\n",
        "        for f_views in bag_chunks:\n",
        "            F_rgb, attn_w = self.gated_attention(f_views)\n",
        "            pooled_fruits.append(F_rgb)\n",
        "            attn_weights_list.append(attn_w)\n",
        "        F_rgb_batch = torch.stack(pooled_fruits, dim=0)  # [B, 256]\n",
        "        return F_rgb_batch, attn_weights_list\n",
        "\n",
        "    def forward(\n",
        "        self,\n",
        "        flat_images: torch.Tensor,\n",
        "        view_counts: Optional[List[int]] = None\n",
        "    ) -> Tuple[torch.Tensor, torch.Tensor, List[torch.Tensor], torch.Tensor]:\n",
        "        \"\"\"\n",
        "        If `view_counts` is provided, performs Multi-View Gated Attention Pooling per fruit.\n",
        "        If `view_counts` is None, treats each image in `flat_images` as a single-view bag (N=1).\n",
        "        Returns:\n",
        "            bag_logits       : [B, num_classes] fruit-level logits from F_rgb\n",
        "            F_rgb_batch      : [B, 256] aggregated fruit-level embeddings\n",
        "            attn_weights_list: List of [N_i] attention weight tensors per fruit\n",
        "            view_logits      : [Total_Views, num_classes] auxiliary per-view logits\n",
        "        \"\"\"\n",
        "        f_all_views = self.extract_view_embeddings(flat_images)  # [Total_Views, 256]\n",
        "        view_logits = self.classification_head(f_all_views)      # [Total_Views, 3]\n",
        "\n",
        "        if view_counts is None:\n",
        "            view_counts = [1] * flat_images.size(0)\n",
        "\n",
        "        F_rgb_batch, attn_weights_list = self.pool_fruit_bags(f_all_views, view_counts)\n",
        "        bag_logits = self.classification_head(F_rgb_batch)       # [B, 3]\n",
        "        return bag_logits, F_rgb_batch, attn_weights_list, view_logits\n",
        "\n",
        "model = DINOv3MultiViewGatedAttention(\n",
        "    num_classes=len(RIPENESS_ORDER),\n",
        "    embed_dim=256,\n",
        "    attn_hidden_dim=128,\n",
        "    drop_path_rate=0.2,\n",
        "    proj_dropout=0.25,\n",
        "    head_dropout=0.25,\n",
        "    raw_cache_path=RAW_PRETRAINED_BACKBONE_PATH\n",
        ").to(DEVICE)\n",
        "\n",
        "total_params = sum(p.numel() for p in model.parameters())\n",
        "backbone_params = sum(p.numel() for p in model.backbone.parameters())\n",
        "head_and_attn_params = total_params - backbone_params\n",
        "print(f\"✅ Initialized Multi-View DINOv3 ('{model.model_name}') + Gated Attention + Classification Head:\")\n",
        "print(f\"   • Total Parameters           : {total_params / 1e6:.2f} M\")\n",
        "print(f\"   • DINOv3 Backbone ({model.backbone_dim}-d)    : {backbone_params / 1e6:.2f} M\")\n",
        "print(f\"   • Proj(256-d) + GatedAttn(128-d) + Head Params: {head_and_attn_params / 1e3:.1f} K\")\n"
      ]
    },
    {
      "cell_type": "code",
