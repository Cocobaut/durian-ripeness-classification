        "# 10. Multi-View Training & Validation Loop with Hybrid Bag/View Loss & Gated Attention Pooling\n",
        "scaler = torch.amp.GradScaler('cuda', enabled=(DEVICE.type == 'cuda'))\n",
        "\n",
        "def expand_fruit_labels_to_views(fruit_labels: torch.Tensor, view_counts: List[int]) -> torch.Tensor:\n",
        "    \"\"\"Repeat each fruit label N_i times to match the flattened view tensors.\"\"\"\n",
        "    repeats = torch.tensor(view_counts, device=fruit_labels.device, dtype=torch.long)\n",
        "    return torch.repeat_interleave(fruit_labels, repeats, dim=0)\n",
        "\n",
        "def train_one_epoch(\n",
        "    model: DINOv3MultiViewGatedAttention,\n",
        "    loader: DataLoader,\n",
        "    optimizer: torch.optim.Optimizer,\n",
        "    criterion: nn.Module,\n",
        "    device: torch.device,\n",
        "    scaler: torch.amp.GradScaler,\n",
        "    epoch: int\n",
        ") -> Tuple[float, float]:\n",
        "    model.train()\n",
        "    total_loss = 0.0\n",
        "    total_fruits = 0\n",
        "    all_preds, all_targets = [], []\n",
        "\n",
        "    # Enable gentle Feature-Space Mixup on aggregated 256-d F_rgb from Epoch 11 onward\n",
        "    use_feature_mixup = (epoch > 10)\n",
        "    optimizer.zero_grad()\n",
        "\n",
        "    pbar = tqdm(loader, desc=f\"Train Ep {epoch:02d}\", leave=False)\n",
        "    for step, batch in enumerate(pbar, start=1):\n",
        "        flat_images = batch[\"flat_images\"].to(device, non_blocking=True)\n",
        "        view_counts = batch[\"view_counts\"]\n",
        "        fruit_targets = batch[\"labels\"].to(device, non_blocking=True)\n",
        "        view_targets = expand_fruit_labels_to_views(fruit_targets, view_counts)\n",
        "        batch_fruits = fruit_targets.size(0)\n",
        "\n",
        "        with torch.amp.autocast('cuda', enabled=(device.type == 'cuda')):\n",
        "            bag_logits, F_rgb_batch, _, view_logits = model(flat_images, view_counts)\n",
        "            aux_view_loss = criterion(view_logits, view_targets)\n",
        "\n",
        "            if use_feature_mixup and batch_fruits > 1 and random.random() < 0.30:\n",
        "                mixed_F_rgb, targets_a, targets_b, lam = apply_feature_mixup(F_rgb_batch, fruit_targets, alpha=0.2)\n",
        "                mixed_bag_logits = model.classification_head(mixed_F_rgb)\n",
        "                bag_loss = lam * criterion(mixed_bag_logits, targets_a) + (1.0 - lam) * criterion(mixed_bag_logits, targets_b)\n",
        "            else:\n",
        "                bag_loss = criterion(bag_logits, fruit_targets)\n",
        "\n",
        "            loss = (1.0 - AUX_VIEW_LOSS_WEIGHT) * bag_loss + AUX_VIEW_LOSS_WEIGHT * aux_view_loss\n",
        "            scaled_loss = loss / GRAD_ACCUM_STEPS\n",
        "\n",
        "        scaler.scale(scaled_loss).backward()\n",
        "\n",
        "        if (step % GRAD_ACCUM_STEPS == 0) or (step == len(loader)):\n",
        "            scaler.unscale_(optimizer)\n",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=2.0)\n",
        "            scaler.step(optimizer)\n",
        "            scaler.update()\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "        total_loss += loss.item() * batch_fruits\n",
        "        total_fruits += batch_fruits\n",
        "        preds = torch.argmax(bag_logits, dim=1).detach().cpu().numpy()\n",
        "        all_preds.extend(preds)\n",
        "        all_targets.extend(fruit_targets.cpu().numpy())\n",
        "        pbar.set_postfix({\"loss\": f\"{loss.item():.4f}\", \"views\": flat_images.size(0)})\n",
        "\n",
        "    epoch_loss = total_loss / max(1, total_fruits)\n",
        "    epoch_fruit_acc = accuracy_score(all_targets, all_preds)\n",
        "    return epoch_loss, epoch_fruit_acc\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate_multiview(\n",
        "    model: DINOv3MultiViewGatedAttention,\n",
        "    loader: DataLoader,\n",
        "    criterion: nn.Module,\n",
        "    device: torch.device\n",
        ") -> Tuple[float, float, float, float, np.ndarray, np.ndarray]:\n",
        "    model.eval()\n",
        "    total_loss = 0.0\n",
        "    total_fruits = 0\n",
        "    all_fruit_preds, all_fruit_targets = [], []\n",
        "    all_view_preds, all_view_targets = [], []\n",
        "\n",
        "    for batch in loader:\n",
        "        flat_images = batch[\"flat_images\"].to(device, non_blocking=True)\n",
        "        view_counts = batch[\"view_counts\"]\n",
        "        fruit_targets = batch[\"labels\"].to(device, non_blocking=True)\n",
        "        view_targets = expand_fruit_labels_to_views(fruit_targets, view_counts)\n",
        "        batch_fruits = fruit_targets.size(0)\n",
        "\n",
        "        with torch.amp.autocast('cuda', enabled=(device.type == 'cuda')):\n",
        "            bag_logits, _, _, view_logits = model(flat_images, view_counts)\n",
        "            bag_loss = criterion(bag_logits, fruit_targets)\n",
        "\n",
        "        total_loss += bag_loss.item() * batch_fruits\n",
        "        total_fruits += batch_fruits\n",
        "\n",
        "        fruit_preds = torch.argmax(bag_logits, dim=1).cpu().numpy()\n",
        "        view_preds = torch.argmax(view_logits, dim=1).cpu().numpy()\n",
        "\n",
        "        all_fruit_preds.extend(fruit_preds)\n",
        "        all_fruit_targets.extend(fruit_targets.cpu().numpy())\n",
        "        all_view_preds.extend(view_preds)\n",
        "        all_view_targets.extend(view_targets.cpu().numpy())\n",
        "\n",
        "    val_loss = total_loss / max(1, total_fruits)\n",
        "    val_fruit_acc = accuracy_score(all_fruit_targets, all_fruit_preds)\n",
        "    val_fruit_f1 = f1_score(all_fruit_targets, all_fruit_preds, average=\"macro\", zero_division=0)\n",
        "    val_view_acc = accuracy_score(all_view_targets, all_view_preds)\n",
        "    return val_loss, val_fruit_acc, val_fruit_f1, val_view_acc, np.array(all_fruit_targets), np.array(all_fruit_preds)\n",
        "\n",
        "print(f\"[*] Starting Multi-View DINOv3 + Gated Attention training from Epoch {start_epoch} to {EPOCHS}...\")\n",
        "print(f\"[*] Safeguard: Training halts if Fruit-Level Val Macro-F1 does not improve for {early_stopping.patience} epochs (after Ep {early_stopping.min_epochs})!\")\n",
        "\n",
        "for epoch in range(start_epoch, EPOCHS + 1):\n",
        "    t0 = time.time()\n",
        "    \n",
        "    train_loss, train_fruit_acc = train_one_epoch(model, train_loader, optimizer, criterion, DEVICE, scaler, epoch)\n",
        "    val_loss, val_fruit_acc, val_fruit_f1, val_view_acc, _, _ = evaluate_multiview(model, val_loader, criterion, DEVICE)\n",
        "    \n",
        "    scheduler.step()\n",
        "    curr_bb_lr = optimizer.param_groups[0][\"lr\"]\n",
        "    curr_hd_lr = optimizer.param_groups[2][\"lr\"]\n",
        "    \n",
        "    history[\"train_loss\"].append(train_loss)\n",
        "    history[\"val_loss\"].append(val_loss)\n",
        "    history[\"train_fruit_acc\"].append(train_fruit_acc)\n",
        "    history[\"val_fruit_acc\"].append(val_fruit_acc)\n",
        "    history[\"val_fruit_f1\"].append(val_fruit_f1)\n",
        "    history[\"val_view_acc\"].append(val_view_acc)\n",
        "    \n",
        "    dt = time.time() - t0\n",
        "    print(f\"Epoch [{epoch:02d}/{EPOCHS:02d}] ({dt:.1f}s) | \"\n",
        "          f\"Train Loss: {train_loss:.4f} - Fruit-Acc: {train_fruit_acc:.3f} | \"\n",
        "          f\"Val Loss: {val_loss:.4f} - Fruit-Acc: {val_fruit_acc:.3f} - Fruit-F1: {val_fruit_f1:.4f} (View-Acc: {val_view_acc:.3f}) | \"\n",
        "          f\"BB-LR: {curr_bb_lr:.6f} - Head-LR: {curr_hd_lr:.6f}\")\n",
        "    \n",
        "    # CHECK BEST MODEL CRITERION BASED ON FRUIT-LEVEL VAL MACRO-F1\n",
        "    is_improved = early_stopping(val_fruit_f1, epoch)\n",
        "    if is_improved:\n",
        "        best_val_loss = val_loss\n",
        "        best_val_f1 = val_fruit_f1\n",
        "        best_epoch = epoch\n",
        "        print(f\"  ⭐ NEW BEST FRUIT-LEVEL OPTIMUM! Val Fruit Macro-F1 = {val_fruit_f1:.4f} | Val Loss = {val_loss:.4f}\")\n",
        "        \n",
        "        # 1) Save full model checkpoint\n",
        "        save_full_checkpoint(\n",
        "            model, optimizer.state_dict(), scheduler.state_dict(),\n",
        "            epoch, best_val_loss, best_val_f1, best_epoch, history, BEST_FULL_CHECKPOINT_PATH\n",
        "        )\n",
        "        # 2) Save 256-d Multi-View DINOv3 Extractor & Classification Head in separate .pt files (never overwrite each other)\n",
        "        save_separate_backbone_and_head(\n",
        "            model, epoch, best_val_loss, best_val_f1,\n",
        "            BACKBONE_PROJ_BEST_PATH, CLASSIFICATION_HEAD_BEST_PATH\n",
        "        )\n",
        "        print(f\"  💾 Saved separate 256-d DINOv3 Extractor -> {os.path.basename(BACKBONE_PROJ_BEST_PATH)} & Head -> {os.path.basename(CLASSIFICATION_HEAD_BEST_PATH)}\")\n",
        "    else:\n",
        "        print(f\"  ⏳ EarlyStopping Counter: {early_stopping.counter}/{early_stopping.patience} (Best Val Fruit Macro-F1: {early_stopping.best_score:.4f} at Ep {best_epoch})\")\n",
        "\n",
        "    # Always save latest epoch checkpoint against disconnections / timeouts\n",
        "    save_full_checkpoint(\n",
        "        model, optimizer.state_dict(), scheduler.state_dict(),\n",
        "        epoch, best_val_loss, best_val_f1, best_epoch, history, LAST_FULL_CHECKPOINT_PATH\n",
        "    )\n",
        "\n",
        "    # Periodic checkpointing every SAVE_EVERY_EPOCHS epochs\n",
        "    if epoch % SAVE_EVERY_EPOCHS == 0:\n",
        "        periodic_cp_path = os.path.join(CHECKPOINT_DIR, f\"dinov3_multiview_periodic_epoch_{epoch:02d}.pt\")\n",
        "        save_full_checkpoint(\n",
        "            model, optimizer.state_dict(), scheduler.state_dict(),\n",
        "            epoch, best_val_loss, best_val_f1, best_epoch, history, periodic_cp_path\n",
        "        )\n",
        "        print(f\"  📌 [PERIODIC CHECKPOINT] Saved snapshot at: {periodic_cp_path}\")\n",
        "\n",
        "    # TRIGGER EARLY STOPPING IF VAL FRUIT MACRO-F1 STAGNATES\n",
        "    if early_stopping.early_stop:\n",
        "        print(f\"\\n⏹️ [EARLY STOPPING TRIGGERED AT EPOCH {epoch}]\")\n",
        "        print(f\"   Fruit-Level Val Macro-F1 did not improve for {early_stopping.patience} consecutive epochs.\")\n",
