        "    best_epoch: int,\n",
        "    history: Dict,\n",
        "    save_path: str\n",
        "):\n",
        "    payload = {\n",
        "        \"epoch\": epoch,\n",
        "        \"best_epoch\": best_epoch,\n",
        "        \"model_state_dict\": model_obj.state_dict(),\n",
        "        \"backbone_state_dict\": model_obj.backbone.state_dict(),\n",
        "        \"projection_state_dict\": model_obj.projection.state_dict(),\n",
        "        \"gated_attention_state_dict\": model_obj.gated_attention.state_dict(),\n",
        "        \"classification_head_state_dict\": model_obj.classification_head.state_dict(),\n",
        "        \"optimizer_state_dict\": state_dict_optimizer,\n",
