        "print(f\"\\n🏁 Training complete! Best Multi-View DINOv3 model at Epoch {best_epoch} with Val Fruit Macro-F1: {best_val_f1:.4f} (Val Loss: {best_val_loss:.4f})\")\n"
      ]
