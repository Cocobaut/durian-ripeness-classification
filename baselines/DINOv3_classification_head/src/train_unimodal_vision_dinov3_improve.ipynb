        "        \"attn_hidden_dim\": model_obj.attn_hidden_dim,\n",
        "        \"timestamp\": time.strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "    }\n",
        "    torch.save(payload, save_path)\n",
        "\n",
        "def save_separate_backbone_and_head(\n",
        "    model_obj: DINOv3MultiViewGatedAttention,\n",
        "    epoch: int,\n",
        "    best_val_loss: float,\n",
